{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typegen": "next typegen",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "smoke:routes": "node scripts/e2e.mjs",
    "test:db": "node scripts/db-test.mjs --reset --run ../../supabase/tests/tenant_parent_integrity_tests.sql",
    "test:db:dvi": "node scripts/db-test.mjs --run ../../supabase/tests/dvi_security_tests.sql",
    "test:db:dvi:strict": "node scripts/db-test.mjs --reset --run ../../supabase/tests/dvi_security_tests.sql",
    "test:db:positive-control": "node scripts/db-test.mjs --reset --up-to 0038 --run ../../supabase/tests/tenant_parent_integrity_tests.sql",
    "test:db:finance": "node scripts/db-test.mjs --reset --run ../../supabase/tests/invoice_financial_integrity_tests.sql",
    "test:db:finance:positive-control": "node scripts/db-test.mjs --reset --up-to 0040 --run ../../supabase/tests/invoice_financial_integrity_tests.sql",
    "test:db:audit": "node scripts/db-test.mjs --reset --run ../../supabase/tests/audit_and_privilege_tests.sql",
    "test:db:audit:positive-control": "node scripts/db-test.mjs --reset --up-to 0041 --run ../../supabase/tests/audit_and_privilege_tests.sql",
    "test:db:lifecycle": "node scripts/db-test.mjs --reset --run ../../supabase/tests/trusted_record_lifecycle_tests.sql",
    "test:db:lifecycle:positive-control": "node scripts/db-test.mjs --reset --up-to 0042 --run ../../supabase/tests/trusted_record_lifecycle_tests.sql",
    "test:db:auth": "node scripts/db-test.mjs --reset --run ../../supabase/tests/auth_hardening_tests.sql",
    "test:db:auth:positive-control": "node scripts/db-test.mjs --reset --up-to 0043 --run ../../supabase/tests/auth_hardening_tests.sql",
    "test:db:claims": "node scripts/db-test.mjs --reset --run ../../supabase/tests/verified_email_claim_tests.sql",
    "test:db:claims:positive-control": "node scripts/db-test.mjs --reset --up-to 0045 --run ../../supabase/tests/verified_email_claim_tests.sql",
    "test:db:portal": "node scripts/db-test.mjs --reset --run ../../supabase/tests/portal_authorization_matrix_tests.sql",
    "test:db:views": "node scripts/db-test.mjs --reset --run ../../supabase/tests/view_privilege_tests.sql",
    "test:db:views:positive-control": "node scripts/db-test.mjs --reset --up-to 0046 --run ../../supabase/tests/view_privilege_tests.sql",
    "test:db:all": "pnpm test:db && pnpm test:db:finance && pnpm test:db:audit && pnpm test:db:lifecycle && pnpm test:db:auth && pnpm test:db:claims && pnpm test:db:portal && pnpm test:db:views && pnpm test:db:dvi:strict && pnpm audit:embeds && pnpm audit:views && pnpm audit:functions",
    "audit:tenant-fks": "node scripts/audit-tenant-fks.mjs",
    "audit:views": "node scripts/audit-view-security.mjs",
    "audit:views:self-test": "node scripts/audit-view-security.mjs --self-test",
    "audit:functions": "node scripts/audit-function-privileges.mjs",
    "audit:functions:self-test": "node scripts/audit-function-privileges.mjs --self-test",
    "audit:approval-path": "node scripts/audit-approval-path.mjs",
    "audit:migrations": "node scripts/audit-migration-collisions.mjs && node scripts/audit-migration-safety.mjs",
    "diagnose:billing": "node scripts/diagnose-billing-env.mjs",
    "audit:embeds": "node scripts/audit-postgrest-embeds.mjs",
    "audit:embeds:self-test": "node scripts/audit-postgrest-embeds.mjs --self-test",
    "probe:embeds": "node scripts/probe-postgrest-embeds.mjs",
    "build:isolated": "node scripts/build-isolated.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/nextjs": "^10.75.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "next": "15.5.19",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.78.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
